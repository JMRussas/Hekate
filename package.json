{
  "name": "beethoven-fleet",
  "displayName": "Beethoven Fleet Control",
  "description": "Fleet control center for Beethoven AI agent orchestration",
  "version": "0.2.0",
  "publisher": "jmrussas",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "beethoven",
          "title": "Beethoven Fleet",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "beethoven": [
        {
          "id": "beethovenTree",
          "name": "Fleet",
          "type": "tree"
        },
        {
          "id": "beethovenChat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "beethoven.refresh",
        "title": "Refresh Fleet",
        "icon": "$(refresh)"
      },
      {
        "command": "beethoven.selectProject",
        "title": "Select Project"
      },
      {
        "command": "beethoven.startProject",
        "title": "Start Project",
        "icon": "$(play)"
      },
      {
        "command": "beethoven.pauseProject",
        "title": "Pause Project",
        "icon": "$(debug-pause)"
      },
      {
        "command": "beethoven.retryTask",
        "title": "Retry Task",
        "icon": "$(debug-restart)"
      },
      {
        "command": "beethoven.cancelTask",
        "title": "Cancel Task",
        "icon": "$(close)"
      },
      {
        "command": "beethoven.connect",
        "title": "Connect to Beethoven"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "beethoven.startProject",
          "when": "view == beethovenTree && viewItem == project-paused",
          "group": "inline"
        },
        {
          "command": "beethoven.pauseProject",
          "when": "view == beethovenTree && viewItem == project-running",
          "group": "inline"
        },
        {
          "command": "beethoven.retryTask",
          "when": "view == beethovenTree && viewItem == task-failed",
          "group": "inline"
        },
        {
          "command": "beethoven.cancelTask",
          "when": "view == beethovenTree && viewItem == task-running",
          "group": "inline"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "beethovenTree",
        "contents": "Welcome to Beethoven Fleet Control.\n\nThis extension connects to your Orchestration API to manage AI agent projects, tasks, and providers.\n\n**Quick start:**\n1. Ensure the orchestration server is running\n2. Set the API URL in settings (default: 192.168.1.164:5200)\n3. Click Refresh or wait for auto-connect\n\n[Refresh Fleet](command:beethoven.refresh)\n[Set API Key](command:beethoven.connect)\n[Open Settings](command:workbench.action.openSettings?%5B%22beethoven%22%5D)\n\n**Chat commands:**\n`/status` — list all projects\n`/tasks` — show tasks for selected project\n`/start` — start selected project\n`/pause` — pause selected project",
        "when": "!beethoven.connected"
      }
    ],
    "configuration": {
      "title": "Beethoven Fleet",
      "properties": {
        "beethoven.apiUrl": {
          "type": "string",
          "default": "http://localhost:5200",
          "description": "URL of the Beethoven orchestration API (e.g. http://192.168.1.164:5200)"
        },
        "beethoven.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect to the API on activation"
        },
        "beethoven.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama API URL for chat"
        },
        "beethoven.ollamaModel": {
          "type": "string",
          "default": "qwen2.5-coder:14b",
          "description": "Ollama model for chat"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20",
    "typescript": "^5.3"
  },
  "dependencies": {
    "claude-code-js": "^0.4.0"
  }
}
