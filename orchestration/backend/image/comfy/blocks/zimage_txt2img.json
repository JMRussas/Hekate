{
  "name": "zimage_txt2img",
  "description": "Z-Image Turbo text-to-image using UNETLoader + ModelSamplingAuraFlow + CLIPLoader(ltxv) + KSampler",
  "arch": "zimage",
  "inputs": {
    "checkpoint": { "type": "string" },
    "clip_file": { "type": "string" },
    "vae_file": { "type": "string" },
    "prompt": { "type": "string" },
    "negative_prompt": { "type": "string", "default": "" },
    "seed": { "type": "int" },
    "width": { "type": "int", "default": 1024 },
    "height": { "type": "int", "default": 1024 },
    "cfg": { "type": "float", "default": 1.0 },
    "steps": { "type": "int", "default": 8 },
    "sampler": { "type": "string", "default": "euler" },
    "scheduler": { "type": "string", "default": "normal" }
  },
  "outputs": {
    "image": { "node": "vae_decode", "index": 0 }
  },
  "nodes": {
    "unet_loader": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "{{checkpoint}}",
        "weight_dtype": "default"
      }
    },
    "aura_flow": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {
        "model": ["unet_loader", 0],
        "shift": 1.73
      }
    },
    "clip_loader": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "{{clip_file}}",
        "type": "ltxv",
        "device": "default"
      }
    },
    "vae_loader": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "{{vae_file}}"
      }
    },
    "pos_prompt": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["clip_loader", 0],
        "text": "{{prompt}}"
      }
    },
    "neg_prompt": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["clip_loader", 0],
        "text": "{{negative_prompt}}"
      }
    },
    "latent": {
      "class_type": "EmptySD3LatentImage",
      "inputs": {
        "width": "{{width}}",
        "height": "{{height}}",
        "batch_size": 1
      }
    },
    "sampler": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["aura_flow", 0],
        "positive": ["pos_prompt", 0],
        "negative": ["neg_prompt", 0],
        "latent_image": ["latent", 0],
        "seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": "{{cfg}}",
        "sampler_name": "{{sampler}}",
        "scheduler": "{{scheduler}}",
        "denoise": 1.0
      }
    },
    "vae_decode": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["sampler", 0],
        "vae": ["vae_loader", 0]
      }
    }
  }
}
