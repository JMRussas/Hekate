{
  "name": "lumina2_txt2img",
  "description": "Lumina Image 2.0 text-to-image using CheckpointLoaderSimple + ModelSamplingAuraFlow + KSampler",
  "arch": "lumina2",
  "inputs": {
    "checkpoint": { "type": "string" },
    "prompt": { "type": "string" },
    "negative_prompt": { "type": "string", "default": "" },
    "seed": { "type": "int" },
    "width": { "type": "int", "default": 1024 },
    "height": { "type": "int", "default": 1024 },
    "cfg": { "type": "float", "default": 5.0 },
    "steps": { "type": "int", "default": 20 }
  },
  "outputs": {
    "image": { "node": "vae_decode", "index": 0 }
  },
  "nodes": {
    "loader": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "{{checkpoint}}"
      }
    },
    "aura_flow": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {
        "model": ["loader", 0],
        "shift": 6
      }
    },
    "pos_prompt": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["loader", 1],
        "text": "{{prompt}}"
      }
    },
    "neg_prompt": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["loader", 1],
        "text": "{{negative_prompt}}"
      }
    },
    "latent": {
      "class_type": "EmptySD3LatentImage",
      "inputs": {
        "width": "{{width}}",
        "height": "{{height}}",
        "batch_size": 1
      }
    },
    "sampler": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["aura_flow", 0],
        "positive": ["pos_prompt", 0],
        "negative": ["neg_prompt", 0],
        "latent_image": ["latent", 0],
        "seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": "{{cfg}}",
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0
      }
    },
    "vae_decode": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["sampler", 0],
        "vae": ["loader", 2]
      }
    }
  }
}
