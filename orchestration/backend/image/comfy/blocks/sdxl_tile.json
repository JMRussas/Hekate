{
  "name": "sdxl_tile",
  "description": "SDXL seamless tile generation — wraps model with SeamlessTile for tileable game surface textures",
  "arch": "sdxl",
  "inputs": {
    "checkpoint": { "type": "string" },
    "prompt": { "type": "string" },
    "negative_prompt": { "type": "string", "default": "" },
    "seed": { "type": "int" },
    "width": { "type": "int", "default": 512 },
    "height": { "type": "int", "default": 512 },
    "steps": { "type": "int", "default": 20 },
    "cfg": { "type": "float", "default": 7.0 },
    "tiling": { "type": "string", "default": "enable" }
  },
  "outputs": {
    "image": { "node": "vae_decode", "index": 0 }
  },
  "nodes": {
    "loader": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "{{checkpoint}}"
      }
    },
    "seamless": {
      "class_type": "SeamlessTile",
      "inputs": {
        "model": ["loader", 0],
        "tiling": "{{tiling}}"
      }
    },
    "pos_prompt": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["loader", 1],
        "text": "{{prompt}}"
      }
    },
    "neg_prompt": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["loader", 1],
        "text": "{{negative_prompt}}"
      }
    },
    "latent": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": "{{width}}",
        "height": "{{height}}",
        "batch_size": 1
      }
    },
    "sampler": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["seamless", 0],
        "positive": ["pos_prompt", 0],
        "negative": ["neg_prompt", 0],
        "latent_image": ["latent", 0],
        "seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": "{{cfg}}",
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "denoise": 1.0
      }
    },
    "vae_decode": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["sampler", 0],
        "vae": ["loader", 2]
      }
    }
  }
}
