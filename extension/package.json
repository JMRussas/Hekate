{
  "name": "hekate-fleet",
  "displayName": "Hekate Fleet Control",
  "description": "Fleet control center for Hekate AI agent orchestration",
  "version": "0.2.0",
  "publisher": "jmrussas",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hekate",
          "title": "Hekate Fleet",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "hekate": [
        {
          "id": "hekateTree",
          "name": "Fleet",
          "type": "tree"
        },
        {
          "id": "hekateChat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "hekate.refresh",
        "title": "Refresh Fleet",
        "icon": "$(refresh)"
      },
      {
        "command": "hekate.selectProject",
        "title": "Select Project"
      },
      {
        "command": "hekate.startProject",
        "title": "Start Project",
        "icon": "$(play)"
      },
      {
        "command": "hekate.pauseProject",
        "title": "Pause Project",
        "icon": "$(debug-pause)"
      },
      {
        "command": "hekate.retryTask",
        "title": "Retry Task",
        "icon": "$(debug-restart)"
      },
      {
        "command": "hekate.cancelTask",
        "title": "Cancel Task",
        "icon": "$(close)"
      },
      {
        "command": "hekate.connect",
        "title": "Connect to Hekate"
      },
      {
        "command": "hekate.diagnose",
        "title": "Hekate: Diagnose Connection"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "hekate.startProject",
          "when": "view == hekateTree && viewItem == project-paused",
          "group": "inline"
        },
        {
          "command": "hekate.pauseProject",
          "when": "view == hekateTree && viewItem == project-running",
          "group": "inline"
        },
        {
          "command": "hekate.retryTask",
          "when": "view == hekateTree && viewItem == task-failed",
          "group": "inline"
        },
        {
          "command": "hekate.cancelTask",
          "when": "view == hekateTree && viewItem == task-running",
          "group": "inline"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "hekateTree",
        "contents": "Welcome to Hekate Fleet Control.\n\nThis extension connects to your Orchestration API to manage AI agent projects, tasks, and providers.\n\n**Quick start:**\n1. Ensure the orchestration server is running\n2. Set the API URL in settings (default: 192.168.1.164:5200)\n3. Click Refresh or wait for auto-connect\n\n[Refresh Fleet](command:hekate.refresh)\n[Set API Key](command:hekate.connect)\n[Open Settings](command:workbench.action.openSettings?%5B%22hekate%22%5D)\n\n**Chat commands:**\n`/status` — list all projects\n`/tasks` — show tasks for selected project\n`/start` — start selected project\n`/pause` — pause selected project",
        "when": "!hekate.connected"
      }
    ],
    "configuration": {
      "title": "Hekate Fleet",
      "properties": {
        "hekate.apiUrl": {
          "type": "string",
          "default": "http://localhost:5200",
          "description": "URL of the Hekate orchestration API (e.g. http://192.168.1.164:5200)"
        },
        "hekate.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect to the API on activation"
        },
        "hekate.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the Hekate orchestration API (orch_... key)"
        },
        "hekate.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama API URL for chat"
        },
        "hekate.ollamaModel": {
          "type": "string",
          "default": "qwen2.5-coder:14b",
          "description": "Ollama model for chat"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20",
    "typescript": "^5.3"
  },
  "dependencies": {
    "claude-code-js": "^0.4.0"
  }
}
